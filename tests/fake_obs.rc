// SPDX-License-Identifier: GPL-2.0-or-later
// A stand-in for obs.dll in the unit tests: a DLL with nothing in it but a
// version, FAKE_OBS_MAJOR.FAKE_OBS_MINOR.FAKE_OBS_PATCH, which is all
// InspectObsInstall reads from obs.dll.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION FAKE_OBS_MAJOR, FAKE_OBS_MINOR, FAKE_OBS_PATCH, 0
PRODUCTVERSION FAKE_OBS_MAJOR, FAKE_OBS_MINOR, FAKE_OBS_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Stand-in for obs.dll in the unit tests"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
